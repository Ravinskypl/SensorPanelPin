<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SensorPanelGlue</AssemblyName>
    <RootNamespace>SensorPanelGlue</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!--
      DPI awareness is declared in app.manifest (PerMonitorV2). The OS applies it before any managed
      code runs, which is what a tool that measures other windows needs; Application.SetHighDpiMode
      would run too late. The WinForms analyzer WFAC010 assumes the API route, so it is suppressed
      here on purpose - the code never calls SetHighDpiMode, so there is no conflicting setting.
    -->
    <GenerateApplicationConfiguration>false</GenerateApplicationConfiguration>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>SensorPanelGlue</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same file twice on purpose: as the shell icon of the executable, and as a resource so the
         tray and window icons come from one mark instead of a second, drifting definition. -->
    <EmbeddedResource Include="app.ico" LogicalName="SensorPanelGlue.app.ico" />
  </ItemGroup>

</Project>
