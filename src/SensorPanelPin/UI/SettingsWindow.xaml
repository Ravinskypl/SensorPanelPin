<Window x:Class="SensorPanelPin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SensorPanelPin.Localization"
        xmlns:ui="clr-namespace:SensorPanelPin.UI"
        xmlns:pages="clr-namespace:SensorPanelPin.UI.Pages"
        Title="SensorPanelPin"
        Width="1040" Height="740" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation pane, on the window's Mica like the Windows 11 Settings app. -->
        <!-- The title bar already names the app; the pane starts straight with the sections. -->
        <DockPanel Grid.Column="0" Margin="8,20,8,12">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version}" Margin="16,0,0,4"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <ListBox x:Name="Navigation" SelectedIndex="0" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnNavigate"
                     AutomationProperties.Name="{x:Static l:Strings.NavSections}">
                <ListBoxItem AutomationProperties.Name="{x:Static l:Strings.ScreensTitle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE7F4;" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static l:Strings.ScreensTitle}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="SensorPanel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE9D9;" VerticalAlignment="Center" />
                        <TextBlock Text="SensorPanel" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="{x:Static l:Strings.OtherWindowsTitle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE8A7;" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static l:Strings.OtherWindowsTitle}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="{x:Static l:Strings.StartupTitle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE7E8;" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static l:Strings.StartupTitle}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- Content layer: the lighter surface with a rounded top-left corner, as in NavigationView. -->
        <Border Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="Page" Margin="40,28,40,40" MaxWidth="1000" Focusable="False" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
