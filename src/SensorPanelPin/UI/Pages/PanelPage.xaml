<UserControl x:Class="SensorPanelPin.UI.Pages.PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SensorPanelPin.Localization"
             xmlns:ui="clr-namespace:SensorPanelPin.UI">
    <StackPanel>
        <TextBlock Text="SensorPanel" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,20" />

        <ui:InfoBar Severity="{Binding PanelMessageSeverity}" Message="{Binding PanelMessage}"
                    Visibility="{Binding PanelMessage, Converter={StaticResource EmptyToCollapsed}}" />

        <TextBlock Text="{x:Static l:Strings.PositionHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="1,8,0,8" />

        <ui:SettingsCard Icon="&#xE707;" Header="{x:Static l:Strings.KeepPositionHeader}"
                         Description="{x:Static l:Strings.KeepPositionDescription}">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding KeepPanelPosition}"
                          AutomationProperties.Name="{x:Static l:Strings.KeepPositionHeader}" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE740;" Header="{x:Static l:Strings.RestoreSizeHeader}"
                         Description="{x:Static l:Strings.RestoreSizeDescription}">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RestorePanelSize}"
                          AutomationProperties.Name="{x:Static l:Strings.RestoreSizeHeader}" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE81D;" Header="{x:Static l:Strings.RememberedPositionHeader}" Description="{Binding GeometryText}">
            <Button Content="{x:Static l:Strings.RememberCurrentButton}" MinWidth="150" Command="{Binding CapturePositionCommand}" />
        </ui:SettingsCard>

        <TextBlock Text="{x:Static l:Strings.WindowBehaviourHeader}" Style="{StaticResource SectionHeaderStyle}" />

        <ui:SettingsCard Icon="&#xE718;" Header="{x:Static l:Strings.TopmostHeader}"
                         Description="{x:Static l:Strings.TopmostDescription}">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding KeepPanelTopmost}"
                          AutomationProperties.Name="{x:Static l:Strings.TopmostHeader}" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE7C4;" Header="{x:Static l:Strings.HideFromAltTabHeader}"
                         Description="{x:Static l:Strings.HideFromAltTabDescription}">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding HidePanelFromAltTab}"
                          AutomationProperties.Name="{x:Static l:Strings.HideFromAltTabHeader}" />
        </ui:SettingsCard>

        <TextBlock Text="{x:Static l:Strings.AdvancedHeader}" Style="{StaticResource SectionHeaderStyle}" />

        <Expander Style="{StaticResource SettingsExpanderStyle}" AutomationProperties.Name="{x:Static l:Strings.PanelRuleHeader}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="4,0,20,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Text="&#xE943;" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l:Strings.PanelRuleHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Static l:Strings.PanelRuleDescription}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Expander.Header>
            <StackPanel>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.RuleProcessHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.RuleProcessDescription}" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                                 Text="{Binding RuleProcess, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{x:Static l:Strings.RuleProcessHeader}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.RuleClassHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.RuleClassDescription}" TextWrapping="Wrap"
                                       Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                                 Text="{Binding RuleClass, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{x:Static l:Strings.RuleClassHeader}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.RuleTitleHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.RuleTitleDescription}" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                                 Text="{Binding RuleTitle, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{x:Static l:Strings.RuleTitleHeader}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.CheckMatchHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.CheckMatchDescription}" TextWrapping="Wrap"
                                       Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{x:Static l:Strings.ShowAidaWindowsButton}" MinWidth="150" VerticalAlignment="Center"
                                Command="{Binding DiagnosticsCommand}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
