<UserControl x:Class="SensorPanelPin.UI.Pages.PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SensorPanelPin.UI">
    <StackPanel>
        <TextBlock Text="SensorPanel" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,20" />

        <ui:InfoBar Severity="{Binding PanelMessageSeverity}" Message="{Binding PanelMessage}"
                    Visibility="{Binding PanelMessage, Converter={StaticResource EmptyToCollapsed}}" />

        <TextBlock Text="Położenie" Style="{StaticResource SectionHeaderStyle}" Margin="1,8,0,8" />

        <ui:SettingsCard Icon="&#xE707;" Header="Pilnuj miejsca panelu"
                         Description="Przywraca zapamiętane miejsce na ekranie. Gdy wyłączone, pilnowane jest tylko to, żeby panel był na właściwym ekranie.">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding KeepPanelPosition}"
                          AutomationProperties.Name="Pilnuj miejsca panelu" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE740;" Header="Przywracaj też rozmiar"
                         Description="Gdy panel zmieni rozmiar, wraca do zapamiętanego.">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RestorePanelSize}"
                          AutomationProperties.Name="Przywracaj też rozmiar" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE81D;" Header="Zapamiętane miejsce" Description="{Binding GeometryText}">
            <Button Content="Zapamiętaj obecne" MinWidth="150" Command="{Binding CapturePositionCommand}" />
        </ui:SettingsCard>

        <TextBlock Text="Zachowanie okna" Style="{StaticResource SectionHeaderStyle}" />

        <ui:SettingsCard Icon="&#xE718;" Header="Zawsze na wierzchu"
                         Description="AIDA64 potrafi zdejmować to ustawienie. Pewniej jest włączyć je w opcjach SensorPanel w samej AIDA64.">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding KeepPanelTopmost}"
                          AutomationProperties.Name="Zawsze na wierzchu" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE7C4;" Header="Ukryj przy przełączaniu okien"
                         Description="Panel nie pojawia się w Alt+Tab.">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding HidePanelFromAltTab}"
                          AutomationProperties.Name="Ukryj przy przełączaniu okien" />
        </ui:SettingsCard>

        <TextBlock Text="Zaawansowane" Style="{StaticResource SectionHeaderStyle}" />

        <Expander Style="{StaticResource SettingsExpanderStyle}" AutomationProperties.Name="Jak rozpoznać okno panelu">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="4,0,20,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Text="&#xE943;" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Jak rozpoznać okno panelu" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Ustawienia domyślne pasują do AIDA64. Zmień je tylko, jeśli panel nie jest znajdowany."
                                   TextWrapping="Wrap" Margin="0,2,0,0" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Expander.Header>
            <StackPanel>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Program" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Nazwa pliku bez .exe." Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                                 Text="{Binding RuleProcess, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Program" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Klasa okna" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Gwiazdka zastępuje dowolny ciąg znaków, znak zapytania jeden znak." TextWrapping="Wrap"
                                       Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                                 Text="{Binding RuleClass, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Klasa okna" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Tytuł okna" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Puste pole pasuje do każdego tytułu." Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                                 Text="{Binding RuleTitle, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Tytuł okna" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Sprawdź dopasowanie" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Pokazuje wszystkie okna AIDA64 i zaznacza to, które pasuje do powyższych pól." TextWrapping="Wrap"
                                       Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Pokaż okna AIDA64" MinWidth="150" VerticalAlignment="Center"
                                Command="{Binding DiagnosticsCommand}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
