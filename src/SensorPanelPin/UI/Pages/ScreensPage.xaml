<UserControl x:Class="SensorPanelPin.UI.Pages.ScreensPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SensorPanelPin.UI">
    <StackPanel>
        <TextBlock Text="Ekrany" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,20" />

        <ui:InfoBar Severity="Error" Message="{Binding SaveError}"
                    Visibility="{Binding SaveError, Converter={StaticResource EmptyToCollapsed}}" />

        <!-- The desk, to scale. The one bold element of the app: everything else stays quiet. -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="28,24" Margin="0,0,0,4">
            <ui:MonitorMap Height="230"
                           Monitors="{Binding MapMonitors}"
                           PanelActual="{Binding PanelActual}"
                           PanelDesired="{Binding PanelDesired}"
                           PanelState="{Binding PanelState}"
                           ScreenFill="{DynamicResource ControlFillColorSecondaryBrush}"
                           ScreenStroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                           Text="{DynamicResource TextFillColorPrimaryBrush}"
                           SecondaryText="{DynamicResource TextFillColorSecondaryBrush}"
                           Accent="{DynamicResource AccentFillColorDefaultBrush}"
                           TextOnAccent="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           Caution="{DynamicResource SystemFillColorCautionBrush}"
                           AutomationProperties.Name="Mapa ekranów z położeniem SensorPanela" />
        </Border>

        <ui:InfoBar Severity="{Binding StatusSeverity}" Message="{Binding StatusMessage}">
            <Button Content="{Binding StatusActionLabel}" Command="{Binding StatusAction}"
                    Visibility="{Binding StatusActionLabel, Converter={StaticResource EmptyToCollapsed}}" />
        </ui:InfoBar>

        <TextBlock Text="Role ekranów" Style="{StaticResource SectionHeaderStyle}" />

        <ui:SettingsCard Icon="&#xE9D9;" Header="Ekran SensorPanela"
                         Description="Tu panel ma być zawsze. Jeśli ten ekran zniknie, panel czeka na jego powrót.">
            <ComboBox MinWidth="300" ItemsSource="{Binding PanelScreenChoices}"
                      DisplayMemberPath="Label" SelectedValuePath="Id"
                      SelectedValue="{Binding PanelMonitorId}"
                      AutomationProperties.Name="Ekran SensorPanela" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE8A7;" Header="Ekran dla pozostałych okien"
                         Description="Tu trafiają okna, które otworzą się na ekranie panelu.">
            <ComboBox MinWidth="300" ItemsSource="{Binding HostScreenChoices}"
                      DisplayMemberPath="Label" SelectedValuePath="Id"
                      SelectedValue="{Binding HostMonitorId}"
                      AutomationProperties.Name="Ekran dla pozostałych okien" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE7F4;" Header="Numery ekranów"
                         Description="Wyświetla na każdym monitorze jego numer z mapy.">
            <Button Content="Identyfikuj" MinWidth="120" Command="{Binding IdentifyCommand}" />
        </ui:SettingsCard>
    </StackPanel>
</UserControl>
