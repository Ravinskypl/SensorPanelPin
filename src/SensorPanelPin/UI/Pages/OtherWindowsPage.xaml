<UserControl x:Class="SensorPanelPin.UI.Pages.OtherWindowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SensorPanelPin.Localization"
             xmlns:ui="clr-namespace:SensorPanelPin.UI">
    <StackPanel>
        <TextBlock Text="{x:Static l:Strings.OtherWindowsTitle}" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,20" />

        <ui:SettingsCard Icon="&#xE8A7;" Header="{x:Static l:Strings.RelocateHeader}"
                         Description="{x:Static l:Strings.RelocateDescription}">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RelocateForeignWindows}"
                          AutomationProperties.Name="{x:Static l:Strings.RelocateHeader}" />
        </ui:SettingsCard>

        <!-- ============================================================== exceptions -->
        <TextBlock Text="{x:Static l:Strings.ExceptionsHeader}" Style="{StaticResource SectionHeaderStyle}" />
        <TextBlock Text="{x:Static l:Strings.ExceptionsDescription}" Margin="1,-4,0,10"
                   Style="{DynamicResource CaptionTextBlockStyle}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Style="{StaticResource ListCardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static l:Strings.NoExceptions}" Style="{StaticResource EmptyStateStyle}"
                           Visibility="{Binding Exceptions.Count, Converter={StaticResource EmptyToVisible}, FallbackValue=Collapsed}" />
                <ItemsControl ItemsSource="{Binding Exceptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10,8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" Style="{DynamicResource CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="&#xE74D;" Style="{StaticResource SubtleIconButtonStyle}"
                                            Command="{Binding Remove}" ToolTip="{x:Static l:Strings.RemoveException}"
                                            AutomationProperties.Name="{x:Static l:Strings.RemoveException}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Adding sits in the same card as the list it extends. -->
                <Grid Margin="16,12,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static l:Strings.RuleProcessHeader}" Margin="0,0,0,4" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding NewExceptionProcess, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static l:Strings.ExceptionProcessName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static l:Strings.ExceptionTitleLabel}" Margin="0,0,0,4" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding NewExceptionTitle, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static l:Strings.ExceptionTitleName}" />
                    </StackPanel>
                    <Button Grid.Column="4" VerticalAlignment="Bottom" Content="{x:Static l:Strings.AddExceptionButton}"
                            Command="{Binding AddExceptionCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================================== abandoned windows -->
        <TextBlock Text="{x:Static l:Strings.ProblemsHeader}" Style="{StaticResource SectionHeaderStyle}" />
        <TextBlock Margin="1,-4,0,10" TextWrapping="Wrap"
                   Text="{x:Static l:Strings.ProblemsDescription}"
                   Style="{DynamicResource CaptionTextBlockStyle}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Style="{StaticResource ListCardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static l:Strings.NoProblems}" Style="{StaticResource EmptyStateStyle}"
                           Visibility="{Binding Problems.Count, Converter={StaticResource EmptyToVisible}, FallbackValue=Collapsed}" />
                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{x:Static l:Strings.ForgiveButton}" HorizontalAlignment="Left" Margin="16,12,16,14"
                        Command="{Binding ForgiveCommand}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
