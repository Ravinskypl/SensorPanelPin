<UserControl x:Class="SensorPanelPin.UI.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SensorPanelPin.Localization"
             xmlns:ui="clr-namespace:SensorPanelPin.UI">
    <UserControl.Resources>
        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="ChoiceDetail" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="UnitText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Static l:Strings.StartupTitle}" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,20" />

        <ui:InfoBar Severity="Warning" Message="{Binding LocationWarning}"
                    Visibility="{Binding LocationWarning, Converter={StaticResource EmptyToCollapsed}}">
            <Button Content="{x:Static l:Strings.InstallButton}" MinWidth="110" Command="{Binding InstallCommand}" />
        </ui:InfoBar>
        <ui:InfoBar Severity="{Binding AutoStartMessageSeverity}" Message="{Binding AutoStartMessage}"
                    Visibility="{Binding AutoStartMessage, Converter={StaticResource EmptyToCollapsed}}" />

        <TextBlock Text="{x:Static l:Strings.WithWindowsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="1,8,0,8" />

        <!-- One question, three answers: a radio group in one card, each answer saying what it costs. -->
        <Border Style="{StaticResource ListCardStyle}" Padding="16,14">
            <StackPanel>
                <RadioButton GroupName="AutoStart" IsChecked="{Binding AutoStartDisabled}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.AutoStartOff}" Style="{StaticResource ChoiceTitle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="AutoStart" IsChecked="{Binding AutoStartRegistry}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.AutoStartRegistry}" Style="{StaticResource ChoiceTitle}" />
                        <TextBlock Style="{StaticResource ChoiceDetail}"
                                   Text="{x:Static l:Strings.AutoStartRegistryDetail}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="AutoStart" IsChecked="{Binding AutoStartElevated}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.AutoStartElevated}" Style="{StaticResource ChoiceTitle}" />
                        <TextBlock Style="{StaticResource ChoiceDetail}"
                                   Text="{x:Static l:Strings.AutoStartElevatedDetail}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <ui:SettingsCard Icon="&#xE769;" Header="{x:Static l:Strings.StartPausedHeader}"
                         Description="{x:Static l:Strings.StartPausedDescription}">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartPaused}"
                          AutomationProperties.Name="{x:Static l:Strings.StartPausedHeader}" />
        </ui:SettingsCard>

        <!-- Only the installed copy can be uninstalled; a downloaded one offers Install above instead. -->
        <ui:SettingsCard Icon="&#xE74D;" Header="{x:Static l:Strings.UninstallHeader}"
                         Description="{x:Static l:Strings.UninstallDescription}"
                         Visibility="{Binding IsInstalledCopy, Converter={StaticResource BoolToVisible}}">
            <Button Content="{x:Static l:Strings.UninstallButton}" MinWidth="110" Command="{Binding UninstallCommand}" />
        </ui:SettingsCard>

        <TextBlock Text="{x:Static l:Strings.DiagnosticsHeader}" Style="{StaticResource SectionHeaderStyle}" />

        <ui:SettingsCard Icon="&#xE9F9;" Header="{x:Static l:Strings.VerboseLogHeader}"
                         Description="{x:Static l:Strings.VerboseLogDescription}">
            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding VerboseLogging}"
                          AutomationProperties.Name="{x:Static l:Strings.VerboseLogHeader}" />
        </ui:SettingsCard>

        <ui:SettingsCard Icon="&#xE8B7;" Header="{x:Static l:Strings.LogAndSettingsHeader}" Description="{Binding LogFolder}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static l:Strings.OpenLogButton}" MinWidth="110" Command="{Binding OpenLogsCommand}" />
                <Button Content="{x:Static l:Strings.OpenSettingsFolderButton}" MinWidth="110" Margin="8,0,0,0" Command="{Binding OpenConfigCommand}" />
            </StackPanel>
        </ui:SettingsCard>

        <TextBlock Text="{x:Static l:Strings.AdvancedHeader}" Style="{StaticResource SectionHeaderStyle}" />

        <Expander Style="{StaticResource SettingsExpanderStyle}" AutomationProperties.Name="{x:Static l:Strings.TimingsHeader}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="4,0,20,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Text="&#xE916;" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l:Strings.TimingsHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Static l:Strings.TimingsDescription}" Margin="0,2,0,0"
                                   Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Expander.Header>
            <StackPanel>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.SafetyPollHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.SafetyPollDescription}" Style="{StaticResource ChoiceDetail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="80" Text="{Binding SafetyPollSeconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{x:Static l:Strings.SafetyPollName}" />
                            <TextBlock Text="s" Style="{StaticResource UnitText}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.DebounceHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.DebounceDescription}" Style="{StaticResource ChoiceDetail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="80" Text="{Binding EventDebounceMs, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{x:Static l:Strings.DebounceName}" />
                            <TextBlock Text="ms" Style="{StaticResource UnitText}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.DisplayDelayHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.DisplayDelayDescription}" Style="{StaticResource ChoiceDetail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="80" Text="{Binding DisplayChangeDelayMs, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{x:Static l:Strings.DisplayDelayName}" />
                            <TextBlock Text="ms" Style="{StaticResource UnitText}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.PingPongLimitHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.PingPongLimitDescription}" Style="{StaticResource ChoiceDetail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="80" Text="{Binding PingPongLimit, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{x:Static l:Strings.PingPongLimitName}" />
                            <TextBlock Text="{x:Static l:Strings.PingPongLimitUnit}" Style="{StaticResource UnitText}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ExpanderRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static l:Strings.PingPongWindowHeader}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.PingPongWindowDescription}" Style="{StaticResource ChoiceDetail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="80" Text="{Binding PingPongWindowSeconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{x:Static l:Strings.PingPongWindowName}" />
                            <TextBlock Text="s" Style="{StaticResource UnitText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
